# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/car-rental

# For MongoDB Atlas (cloud), use format:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/car-rental?retryWrites=true&w=majority

# JWT Secret Key (IMPORTANT: Change this to a secure random string in production)
# Generate a secure secret with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-to-a-secure-random-string

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Email Configuration (for password reset emails)
# Option 1: Gmail (recommended for testing)
# Get App Password: https://myaccount.google.com/apppasswords
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-char-app-password
# EMAIL_FROM=your-email@gmail.com

# Option 2: Custom SMTP Server
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@example.com
# EMAIL_PASS=your-password
# EMAIL_FROM=noreply@example.com

# Razorpay Payment Gateway Configuration
# Get your keys from: https://dashboard.razorpay.com/app/keys
# For testing, use Test Mode keys
# For production, use Live Mode keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ==================== EMAIL NOTIFICATION CONFIGURATION ====================
# For New Booking Notifications to Admin
# These settings are used to send email alerts when customers create new bookings

# EMAIL_USER: Your Gmail address that will send the notification emails
EMAIL_USER=your-email@gmail.com

# EMAIL_APP_PASSWORD: App password generated from Gmail (16 characters, remove spaces)
# Steps to generate:
# 1. Enable 2-Factor Authentication: https://myaccount.google.com/security
# 2. Go to App passwords: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Other" device, enter "Car Rental System"
# 4. Copy the 16-character password (remove spaces)
EMAIL_APP_PASSWORD=your-16-char-app-password

# ADMIN_EMAIL: Email address where booking notifications will be sent
# Can be same as EMAIL_USER or a different email address
ADMIN_EMAIL=admin@example.com
